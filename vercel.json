{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/(ar|de|en|es|fr|hi|it|ja|ko|pt|ru|tr|zh)",
      "destination": "/$1/public/index.html"
    },
    {
      "source": "/(ar|de|en|es|fr|hi|it|ja|ko|pt|ru|tr|zh)/images",
      "destination": "/$1/public/images.html"
    },
    {
      "source": "/(ar|de|en|es|fr|hi|it|ja|ko|pt|ru|tr|zh)/(.*)",
      "destination": "/$1/public/$2"
    },
    {
      "source": "/images",
      "destination": "/images.html"
    }
  ]
}
